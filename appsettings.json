{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/studybuddy.db"
  },
  "Email": {
    "Enabled": false,
    "Provider": "Resend",
    "FromName": "Study Buddy",
    "TimeoutSeconds": 15
  },
  "DeckUpload": {
    "MaxFileBytes": 5242880,
    "MinNotesLength": 20,
    "MaxNotesLength": 150000
  },
  "DocumentExtraction": {
    "MaxTxtBytes": 5242880,
    "MaxMarkdownBytes": 5242880,
    "MaxPdfBytes": 20971520,
    "MaxDocxBytes": 20971520,
    "MaxPptxBytes": 20971520,
    "MaxImageBytes": 10485760,
    "MinExtractedTextLength": 20,
    "MaxExtractedTextLength": 150000,
    "MaxPdfPages": 150,
    "MaxPowerPointSlides": 150,
    "MaxDecompressedBytes": 67108864,
    "MaxZipEntries": 2000,
    "MaxImageWidth": 10000,
    "MaxImageHeight": 10000,
    "MaxImagePixels": 40000000,
    "ExtractionTimeoutSeconds": 45,
    "MaxConcurrentExtractions": 3,
    "Ocr": {
      "Enabled": true,
      "ExecutablePath": "",
      "TessDataPath": "",
      "SupportedLanguages": [ "eng", "ben", "eng+ben" ],
      "DefaultLanguage": "eng",
      "TimeoutSeconds": 30,
      "MaxImagesPerDocument": 15,
      "MaxPdfOcrPages": 15
    }
  },
  "DevSeed": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
