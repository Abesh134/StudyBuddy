<div class="sb-spinner-wrap @(Centered ? "sb-spinner-wrap--centered" : "")" role="status" aria-live="polite">
    <span class="sb-spinner @SizeClass" aria-hidden="true"></span>
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span>@Label</span>
    }
    else
    {
        <span class="sr-only">Loading...</span>
    }
</div>

@code {
    [Parameter]
    public string? Label { get; set; } = "Loading...";

    [Parameter]
    public string Size { get; set; } = "md";

    [Parameter]
    public bool Centered { get; set; } = true;

    private string SizeClass => Size switch
    {
        "sm" => "sb-spinner--sm",
        "lg" => "sb-spinner--lg",
        _ => string.Empty
    };
}

