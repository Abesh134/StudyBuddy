@if (!string.IsNullOrEmpty(DisplayMessage))
{
    var isError = DisplayMessage.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
    <div role="alert" style="padding:0.75rem 1rem;margin-bottom:1rem;border-radius:6px;border:1px solid @(isError ? "#DC2626" : "#15803D");color:@(isError ? "#DC2626" : "#15803D");background:@(isError ? "#FEF2F2" : "#F0FDF4");">
        @DisplayMessage
    </div>
}

@code {
    private string? _messageFromCookie;

    [Parameter]
    public string? Message { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? DisplayMessage => Message ?? _messageFromCookie;

    protected override void OnInitialized()
    {
        if (HttpContext is not null &&
            HttpContext.Request.Cookies.TryGetValue(IdentityRedirectManager.StatusCookieName, out var cookieMessage))
        {
            _messageFromCookie = cookieMessage;
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}

