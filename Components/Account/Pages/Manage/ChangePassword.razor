@page "/Account/Manage/ChangePassword"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using StudyBuddy.Models
@using StudyBuddy.Services
@using StudyBuddy.Services.Email

@attribute [Authorize]

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailNotificationService EmailNotificationService
@inject IOptionsMonitor<EmailOptions> EmailOptionsMonitor
@inject NavigationManager NavigationManager
@inject ILogger<ChangePassword> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>Change password - Study Buddy</PageTitle>

<AuthPageShell>
    <section class="sb-auth-single" aria-labelledby="change-password-heading">
        <div class="sb-auth-brand">
            <img src="/images/branding/logo.svg" alt="Study Buddy" width="132" height="28" />
        </div>

        <h1 id="change-password-heading" class="sb-auth-title">
            Change <span class="sb-marker-underline">password</span>
        </h1>
        <p class="sb-auth-subtitle">Update your password to keep your study workspace secure.</p>

        <StatusMessage Message="@_message" />

        <EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="change-password" data-auth-form="true">
            <DataAnnotationsValidator />
            <ValidationSummary role="alert" />

            <div class="sb-auth-field">
                <label class="sb-auth-label" for="Input.OldPassword">Current password</label>
                <div class="sb-input-wrap">
                    <InputText type="password"
                               @bind-Value="Input.OldPassword"
                               id="Input.OldPassword"
                               class="sb-input sb-input--with-toggle"
                               autocomplete="current-password"
                               aria-required="true" />
                    <button type="button"
                            class="sb-password-toggle"
                            data-password-toggle="Input.OldPassword"
                            aria-label="Show password"
                            aria-pressed="false">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <ValidationMessage For="() => Input.OldPassword" />
            </div>

            <div class="sb-auth-field">
                <label class="sb-auth-label" for="Input.NewPassword">New password</label>
                <div class="sb-input-wrap">
                    <InputText type="password"
                               @bind-Value="Input.NewPassword"
                               id="Input.NewPassword"
                               class="sb-input sb-input--with-toggle"
                               autocomplete="new-password"
                               aria-required="true"
                               aria-describedby="change-password-hints"
                               data-password-strength="true" />
                    <button type="button"
                            class="sb-password-toggle"
                            data-password-toggle="Input.NewPassword"
                            aria-label="Show password"
                            aria-pressed="false">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <ValidationMessage For="() => Input.NewPassword" />

                <div id="change-password-hints" class="sb-strength-wrap" data-strength-meter="true">
                    <div class="sb-strength-bars" aria-hidden="true">
                        <span class="sb-strength-bar" data-strength-bar></span>
                        <span class="sb-strength-bar" data-strength-bar></span>
                        <span class="sb-strength-bar" data-strength-bar></span>
                        <span class="sb-strength-bar" data-strength-bar></span>
                    </div>
                    <div class="sb-strength-meta">
                        <span>Password strength hint</span>
                        <span class="sb-strength-label" data-strength-label aria-live="polite">Enter a password</span>
                    </div>
                    <ul class="sb-req-list">
                        <li class="sb-req-item" data-req="length">8+ characters</li>
                        <li class="sb-req-item" data-req="upper">Uppercase letter</li>
                        <li class="sb-req-item" data-req="lower">Lowercase letter</li>
                        <li class="sb-req-item" data-req="digit">At least 1 number</li>
                    </ul>
                </div>
            </div>

            <div class="sb-auth-field">
                <label class="sb-auth-label" for="Input.ConfirmPassword">Confirm new password</label>
                <div class="sb-input-wrap">
                    <InputText type="password"
                               @bind-Value="Input.ConfirmPassword"
                               id="Input.ConfirmPassword"
                               class="sb-input sb-input--with-toggle"
                               autocomplete="new-password"
                               aria-required="true"
                               data-password-confirm="true" />
                    <button type="button"
                            class="sb-password-toggle"
                            data-password-toggle="Input.ConfirmPassword"
                            aria-label="Show password"
                            aria-pressed="false">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <ValidationMessage For="() => Input.ConfirmPassword" />
                <div class="sb-match-hint" data-match-hint aria-live="polite"></div>
            </div>

            <button type="submit" class="sb-btn sb-btn-primary sb-auth-submit" data-loading-text="Updating password...">
                Update password
            </button>
        </EditForm>

        <div class="sb-auth-footer">
            <p><a href="/settings">Back to settings</a> &middot; <a href="/dashboard">Dashboard</a></p>
        </div>
    </section>
</AuthPageShell>

@code {
    private string? _message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectTo("/Account/Login");
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            _message = "Error: " + string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        // Refresh the current authenticated session with the updated security stamp
        // while other older sessions are invalidated on revalidation.
        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User changed their password successfully.");

        // Send automatic password security notification non-blockingly.
        try
        {
            var recoveryUrl = TrustedUrlHelper.BuildAbsoluteUrl(
                EmailOptionsMonitor.CurrentValue.AppBaseUrl,
                NavigationManager.BaseUri,
                "/Account/ForgotPassword");

            await EmailNotificationService.SendPasswordChangedNotificationAsync(
                user,
                DateTime.UtcNow,
                recoveryUrl);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Password change security notification failed after authenticated password change.");
        }

        RedirectManager.RedirectToCurrentPageWithStatus("Your password has been updated.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        public string OldPassword { get; set; } = string.Empty;

        [Required]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "The new password must be at least 8 characters long.")]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = string.Empty;

        [Required]
        [DataType(DataType.Password)]
        [Compare(nameof(NewPassword), ErrorMessage = "The new password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
