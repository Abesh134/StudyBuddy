@page "/Account/ForgotPassword"
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options
@using StudyBuddy.Models
@using StudyBuddy.Services
@using StudyBuddy.Services.Email

@inject UserManager<ApplicationUser> UserManager
@inject IEmailNotificationService EmailNotificationService
@inject IStudyBuddyEmailSender EmailSender
@inject IOptionsMonitor<EmailOptions> EmailOptionsMonitor
@inject IHostEnvironment HostEnvironment
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ForgotPassword> Logger

<PageTitle>Forgot password - Study Buddy</PageTitle>

<AuthPageShell>
    <section class="sb-auth-single" aria-labelledby="forgot-heading">
        <div class="sb-auth-brand">
            <img src="/images/branding/logo.svg" alt="Study Buddy" width="132" height="28" />
        </div>

        <h1 id="forgot-heading" class="sb-auth-title">
            Forgot your <span class="sb-marker-underline">password?</span>
        </h1>
        <p class="sb-auth-subtitle">Enter the email address for your Study Buddy account and we will send password reset instructions if an eligible account exists.</p>

        <StatusMessage Message="@_message" />

        @if (HostEnvironment.IsDevelopment() && !EmailSender.IsConfigured && !string.IsNullOrEmpty(_devResetLink))
        {
            <div class="sb-status-banner" style="margin-bottom:1rem;">
                <a href="@_devResetLink" style="font-weight:700;">Reset password (Development only) &rarr;</a>
            </div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="forgot-password" data-auth-form="true">
            <DataAnnotationsValidator />
            <ValidationSummary role="alert" />

            <div class="sb-auth-field">
                <label class="sb-auth-label" for="Input.Email">Email address</label>
                <div class="sb-input-wrap">
                    <span class="sb-input-icon" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="4" width="20" height="16" rx="2" />
                            <path d="m22 7-10 6L2 7" />
                        </svg>
                    </span>
                    <InputText @bind-Value="Input.Email"
                               id="Input.Email"
                               class="sb-input sb-input--with-icon"
                               autocomplete="username"
                               placeholder="you@example.com"
                               aria-required="true" />
                </div>
                <ValidationMessage For="() => Input.Email" />
            </div>

            <button type="submit" class="sb-btn sb-btn-primary sb-auth-submit" data-loading-text="Sending instructions...">
                Send reset instructions &rarr;
            </button>
        </EditForm>

        <div class="sb-auth-footer">
            <p><a href="/Account/Login">Back to sign in</a></p>
        </div>
    </section>
</AuthPageShell>

@code {
    private string? _message;
    private string? _devResetLink;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task OnValidSubmitAsync()
    {
        var email = Input.Email.Trim();
        var user = await UserManager.FindByEmailAsync(email);
        var isEligible = user is not null &&
            (!UserManager.Options.SignIn.RequireConfirmedAccount || await UserManager.IsEmailConfirmedAsync(user));

        if (!EmailSender.IsConfigured)
        {
            if (HostEnvironment.IsDevelopment() && isEligible)
            {
                var code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(
                    await UserManager.GeneratePasswordResetTokenAsync(user!)));
                _devResetLink = NavigationManager.GetUriWithQueryParameters(
                    "/Account/ResetPassword",
                    new Dictionary<string, object?> { ["code"] = code });
                _message = "Development mode: no email provider is configured, so no email was sent.";
                return;
            }

            // Never enumerate accounts or expose tokens in Production when unconfigured.
            RedirectManager.RedirectTo("/Account/ForgotPasswordConfirmation");
            return;
        }

        if (isEligible)
        {
            try
            {
                var code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(
                    await UserManager.GeneratePasswordResetTokenAsync(user!)));

                var resetBaseUrl = TrustedUrlHelper.BuildAbsoluteUrl(
                    EmailOptionsMonitor.CurrentValue.AppBaseUrl,
                    NavigationManager.BaseUri,
                    "/Account/ResetPassword");

                var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                    resetBaseUrl,
                    new Dictionary<string, object?> { ["code"] = code });

                var clientIp = HttpContext?.Connection?.RemoteIpAddress?.ToString();
                await EmailNotificationService.SendPasswordResetEmailAsync(user!, callbackUrl, clientIp);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Unexpected error dispatching password reset email.");
            }
        }

        // Always redirect to generic confirmation to prevent account enumeration.
        RedirectManager.RedirectTo("/Account/ForgotPasswordConfirmation");
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
