@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Check your email - Study Buddy</PageTitle>

<AuthPageShell>
    <section class="sb-auth-single" aria-labelledby="forgot-confirm-heading">
        <div class="sb-auth-brand">
            <img src="/images/branding/logo.svg" alt="Study Buddy" width="132" height="28" />
        </div>

        <div class="sb-confirm-icon sb-confirm-icon--mail" aria-hidden="true">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2.5" />
                <path d="m22 7-10 6.5L2 7" />
            </svg>
        </div>

        <h1 id="forgot-confirm-heading" class="sb-auth-title">
            Check your <span class="sb-marker-underline">email</span>
        </h1>

        <p class="sb-auth-subtitle" style="margin-bottom:1rem;">
            If an account exists with this email address, you will receive instructions to reset your password.
        </p>

        <div class="sb-troubleshoot-box">
            <strong>Did not receive the reset email?</strong>
            <ul>
                <li>Check your spam, junk, or promotions folder.</li>
                <li>Wait at least 30 seconds before requesting another reset link.</li>
                <li>Reset links expire automatically and can only be used once.</li>
            </ul>
        </div>

        <div class="sb-auth-actions">
            <a class="sb-btn sb-btn-primary sb-auth-submit" href="/Account/Login">Back to sign in</a>
            <a class="sb-btn sb-btn-secondary sb-auth-submit" href="/Account/ForgotPassword">Try another email</a>
        </div>
    </section>
</AuthPageShell>
