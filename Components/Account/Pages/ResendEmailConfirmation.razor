@page "/Account/ResendEmailConfirmation"
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options
@using StudyBuddy.Models
@using StudyBuddy.Services
@using StudyBuddy.Services.Email

@inject UserManager<ApplicationUser> UserManager
@inject IEmailNotificationService EmailNotificationService
@inject IStudyBuddyEmailSender EmailSender
@inject IOptionsMonitor<EmailOptions> EmailOptionsMonitor
@inject IHostEnvironment HostEnvironment
@inject NavigationManager NavigationManager

<PageTitle>Resend verification email - Study Buddy</PageTitle>

<AuthPageShell>
    <section class="sb-auth-single" aria-labelledby="resend-heading">
        <div class="sb-auth-brand">
            <img src="/images/branding/logo.svg" alt="Study Buddy" width="132" height="28" />
        </div>

        <h1 id="resend-heading" class="sb-auth-title">
            Resend <span class="sb-marker-underline">verification</span>
        </h1>
        <p class="sb-auth-subtitle">Enter your email address to request a fresh verification link.</p>

        <StatusMessage Message="@_message" />

        @if (HostEnvironment.IsDevelopment() && !EmailSender.IsConfigured && !string.IsNullOrEmpty(_devConfirmationLink))
        {
            <div class="sb-status-banner">
                <a href="@_devConfirmationLink" style="font-weight:700;">Confirm account (Development only) &rarr;</a>
            </div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="resend-email-confirmation" data-auth-form="true">
            <DataAnnotationsValidator />
            <ValidationSummary role="alert" />

            <div class="sb-auth-field">
                <label class="sb-auth-label" for="Input.Email">Email address</label>
                <InputText @bind-Value="Input.Email"
                           id="Input.Email"
                           class="sb-input"
                           autocomplete="username"
                           placeholder="you@example.com"
                           aria-required="true" />
                <ValidationMessage For="() => Input.Email" />
            </div>

            <button type="submit" class="sb-btn sb-btn-primary sb-auth-submit" data-loading-text="Sending...">
                Send verification email
            </button>
        </EditForm>

        <div class="sb-auth-footer">
            <p><a href="/Account/Login">Back to sign in</a></p>
        </div>
    </section>
</AuthPageShell>

@code {
    private string? _message;
    private string? _devConfirmationLink;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task OnValidSubmitAsync()
    {
        var email = Input.Email.Trim();
        var user = await UserManager.FindByEmailAsync(email);

        if (!EmailSender.IsConfigured)
        {
            if (HostEnvironment.IsDevelopment() && user is not null && !await UserManager.IsEmailConfirmedAsync(user))
            {
                var userId = await UserManager.GetUserIdAsync(user);
                var code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(
                    await UserManager.GenerateEmailConfirmationTokenAsync(user)));
                _devConfirmationLink = NavigationManager.GetUriWithQueryParameters(
                    "/Account/ConfirmEmail",
                    new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code });
                _message = "Development mode: no email provider is configured, so no email was sent.";
            }
            else
            {
                _message = "Error: Email delivery is not configured on this server. No email was sent.";
            }

            return;
        }

        // Prevent account enumeration: respond consistently whether the account exists or is already confirmed,
        // while enforcing rate limiting on actual unconfirmed accounts.
        if (user is not null && !await UserManager.IsEmailConfirmedAsync(user))
        {
            var userId = await UserManager.GetUserIdAsync(user);
            var code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(
                await UserManager.GenerateEmailConfirmationTokenAsync(user)));

            var confirmBaseUrl = TrustedUrlHelper.BuildAbsoluteUrl(
                EmailOptionsMonitor.CurrentValue.AppBaseUrl,
                NavigationManager.BaseUri,
                "/Account/ConfirmEmail");

            var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                confirmBaseUrl,
                new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code });

            var result = await EmailNotificationService.SendVerificationEmailAsync(user, callbackUrl);
            if (result.Status == EmailSendStatus.DuplicateSuppressed)
            {
                _message = "Error: Please wait at least 30 seconds before requesting another verification email.";
                return;
            }

            if (!result.Succeeded)
            {
                _message = result.Status == EmailSendStatus.DomainRestricted
                    ? "Error: The current development sender (onboarding@resend.dev) can only send to the verified Resend account email address."
                    : "Error: We could not send the verification email right now. Please try again shortly.";
                return;
            }
        }

        _message = "If an unverified account exists for that email, a verification link has been requested.";
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
