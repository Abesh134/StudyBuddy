@page "/Account/ResetPasswordConfirmation"

<PageTitle>Password reset successful - Study Buddy</PageTitle>

<AuthPageShell>
    <section class="sb-auth-single" aria-labelledby="reset-confirm-heading">
        <div class="sb-auth-brand">
            <img src="/images/branding/logo.svg" alt="Study Buddy" width="132" height="28" />
        </div>

        <div class="sb-confirm-icon sb-confirm-icon--success" aria-hidden="true">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path class="sb-check-path" d="M5 13l4.5 4.5L19 7.5" />
            </svg>
        </div>

        <h1 id="reset-confirm-heading" class="sb-auth-title">
            Password <span class="sb-marker-underline">updated!</span>
        </h1>

        <div role="status" class="sb-status-banner">
            Your password has been reset successfully. Existing sessions have been invalidated for your security.
        </div>

        <p style="color:var(--sb-muted);margin:0 0 1.25rem;font-size:0.95rem;">
            You can now sign in to your private Study Buddy workspace using your new password.
        </p>

        <div class="sb-auth-actions">
            <a class="sb-btn sb-btn-primary sb-auth-submit" href="/Account/Login">Sign in with new password &rarr;</a>
        </div>
    </section>
</AuthPageShell>
