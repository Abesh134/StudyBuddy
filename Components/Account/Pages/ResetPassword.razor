@page "/Account/ResetPassword"
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options
@using StudyBuddy.Models
@using StudyBuddy.Services
@using StudyBuddy.Services.Email

@inject UserManager<ApplicationUser> UserManager
@inject IEmailNotificationService EmailNotificationService
@inject IOptionsMonitor<EmailOptions> EmailOptionsMonitor
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ResetPassword> Logger

<PageTitle>Reset password - Study Buddy</PageTitle>

<AuthPageShell>
    <section class="sb-auth-single" aria-labelledby="reset-heading">
        <div class="sb-auth-brand">
            <img src="/images/branding/logo.svg" alt="Study Buddy" width="132" height="28" />
        </div>

        @if (_invalidLink)
        {
            <div class="sb-confirm-icon sb-confirm-icon--error" aria-hidden="true">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <line x1="12" y1="8" x2="12" y2="12.5" />
                    <circle cx="12" cy="16" r="0.8" fill="currentColor" />
                </svg>
            </div>

            <h1 id="reset-heading" class="sb-auth-title">Reset link invalid or expired</h1>

            <div role="alert" class="sb-status-banner sb-status-banner--error">
                @(_errorMessage ?? "A valid password reset link is required to reset your password.")
            </div>

            <p style="color:var(--sb-muted);margin:0 0 1.25rem;font-size:0.94rem;">
                Password reset links expire automatically and can only be used once. Request a fresh link to continue.
            </p>

            <div class="sb-auth-actions">
                <a class="sb-btn sb-btn-primary sb-auth-submit" href="/Account/ForgotPassword">Request New Reset Link</a>
                <a class="sb-btn sb-btn-secondary sb-auth-submit" href="/Account/Login">Back to sign in</a>
            </div>
        }
        else
        {
            <h1 id="reset-heading" class="sb-auth-title">
                Reset your <span class="sb-marker-underline">password</span>
            </h1>
            <p class="sb-auth-subtitle">Choose a strong new password for your Study Buddy account.</p>

            <StatusMessage Message="@_errorMessage" />

            <EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="reset-password" data-auth-form="true">
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />

                <input type="hidden" name="Input.Code" value="@Input.Code" />

                <div class="sb-auth-field">
                    <label class="sb-auth-label" for="Input.Email">Email address</label>
                    <InputText @bind-Value="Input.Email"
                               id="Input.Email"
                               class="sb-input"
                               autocomplete="username"
                               placeholder="you@example.com"
                               aria-required="true" />
                    <ValidationMessage For="() => Input.Email" />
                </div>

                <div class="sb-auth-field">
                    <label class="sb-auth-label" for="Input.Password">New password</label>
                    <div class="sb-input-wrap">
                        <InputText type="password"
                                   @bind-Value="Input.Password"
                                   id="Input.Password"
                                   class="sb-input sb-input--with-toggle"
                                   autocomplete="new-password"
                                   placeholder="Create a new password"
                                   aria-required="true"
                                   aria-describedby="reset-password-hints"
                                   data-password-strength="true" />
                        <button type="button"
                                class="sb-password-toggle"
                                data-password-toggle="Input.Password"
                                aria-label="Show password"
                                aria-pressed="false">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    <ValidationMessage For="() => Input.Password" />

                    <div id="reset-password-hints" class="sb-strength-wrap" data-strength-meter="true">
                        <div class="sb-strength-bars" aria-hidden="true">
                            <span class="sb-strength-bar" data-strength-bar></span>
                            <span class="sb-strength-bar" data-strength-bar></span>
                            <span class="sb-strength-bar" data-strength-bar></span>
                            <span class="sb-strength-bar" data-strength-bar></span>
                        </div>
                        <div class="sb-strength-meta">
                            <span>Password strength hint</span>
                            <span class="sb-strength-label" data-strength-label aria-live="polite">Enter a password</span>
                        </div>
                        <ul class="sb-req-list">
                            <li class="sb-req-item" data-req="length">8+ characters</li>
                            <li class="sb-req-item" data-req="upper">Uppercase letter</li>
                            <li class="sb-req-item" data-req="lower">Lowercase letter</li>
                            <li class="sb-req-item" data-req="digit">At least 1 number</li>
                        </ul>
                    </div>
                </div>

                <div class="sb-auth-field">
                    <label class="sb-auth-label" for="Input.ConfirmPassword">Confirm new password</label>
                    <div class="sb-input-wrap">
                        <InputText type="password"
                                   @bind-Value="Input.ConfirmPassword"
                                   id="Input.ConfirmPassword"
                                   class="sb-input sb-input--with-toggle"
                                   autocomplete="new-password"
                                   placeholder="Repeat your new password"
                                   aria-required="true"
                                   data-password-confirm="true" />
                        <button type="button"
                                class="sb-password-toggle"
                                data-password-toggle="Input.ConfirmPassword"
                                aria-label="Show password"
                                aria-pressed="false">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    <ValidationMessage For="() => Input.ConfirmPassword" />
                    <div class="sb-match-hint" data-match-hint aria-live="polite"></div>
                </div>

                <button type="submit" class="sb-btn sb-btn-primary sb-auth-submit" data-loading-text="Resetting password...">
                    Reset password
                </button>
            </EditForm>

            <div class="sb-auth-footer">
                <p>Need a new link? <a href="/Account/ForgotPassword">Request another reset email</a></p>
                <p><a href="/Account/Login">Back to sign in</a></p>
            </div>
        }
    </section>
</AuthPageShell>

@code {
    private string? _errorMessage;
    private bool _invalidLink;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();

        if (!string.IsNullOrWhiteSpace(Code) && string.IsNullOrWhiteSpace(Input.Code))
        {
            try
            {
                Input.Code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            }
            catch (FormatException)
            {
                _invalidLink = true;
                _errorMessage = "This password reset link is invalid or malformed.";
            }
        }
        else if (string.IsNullOrWhiteSpace(Input.Code))
        {
            _invalidLink = true;
            _errorMessage = "This password reset link is missing a valid reset token.";
        }
    }

    private async Task OnValidSubmitAsync()
    {
        ApplicationUser? resetUser = null;
        try
        {
            var user = await UserManager.FindByEmailAsync(Input.Email.Trim());
            if (user is null)
            {
                // Do not reveal whether the account exists; reject invalid reset attempt safely.
                _errorMessage = "Error: Unable to reset password. The reset link may be invalid or expired.";
                return;
            }

            var result = await UserManager.ResetPasswordAsync(user, Input.Code, Input.Password);
            if (!result.Succeeded)
            {
                if (result.Errors.Any(e => string.Equals(e.Code, "InvalidToken", StringComparison.OrdinalIgnoreCase)))
                {
                    _errorMessage = "Error: This password reset link is invalid, expired, or has already been used. Please request a new reset link.";
                }
                else
                {
                    _errorMessage = "Error: " + string.Join(" ", result.Errors.Select(e => e.Description));
                }

                return;
            }

            // Rotate security stamp to invalidate existing sessions across devices and circuits.
            await UserManager.UpdateSecurityStampAsync(user);
            Logger.LogInformation("User password reset succeeded and security stamp rotated.");
            resetUser = user;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected server error during password reset.");
            _errorMessage = "Error: An unexpected error occurred while resetting your password. Please try again.";
            return;
        }

        // Send automatic security notification non-blockingly; delivery failures never reverse reset.
        try
        {
            var recoveryUrl = TrustedUrlHelper.BuildAbsoluteUrl(
                EmailOptionsMonitor.CurrentValue.AppBaseUrl,
                NavigationManager.BaseUri,
                "/Account/ForgotPassword");

            await EmailNotificationService.SendPasswordChangedNotificationAsync(
                resetUser,
                DateTime.UtcNow,
                recoveryUrl);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Password change security notification failed after password reset.");
        }

        RedirectManager.RedirectTo("/Account/ResetPasswordConfirmation");
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "The password must be at least 8 characters long.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [Required]
        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        [Required]
        public string Code { get; set; } = string.Empty;
    }
}
